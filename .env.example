# =============================================================================
# DataPulse Platform Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# =============================================================================

# Application Settings
APP_NAME=DataPulse
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
RANDOM_SEED=42

# Database Connection
# Option A: Local zero-dependency SQLite (instant local evaluation):
DATABASE_URL=sqlite:///datapulse_warehouse.db

# Option B: Production PostgreSQL (via Docker Compose or external RDS):
# DATABASE_URL=postgresql+psycopg2://datapulse:datapulse_secure_pass@localhost:5432/datapulse_dw

# PostgreSQL Specific Settings (Used by Docker Compose service)
POSTGRES_DB=datapulse_dw
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=datapulse_secure_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Ingestion Source 2: Mock Orders REST API
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=10.0
API_PAGE_SIZE=50

# Pipeline Execution Settings
BATCH_SIZE=500
RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=0.5
INJECT_DIRTY_DATA_RATIO=0.08
